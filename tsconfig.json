{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "useUnknownInCatchVariables": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": true,
    "paths": {
      "verifactu-ts": ["./src/index.ts"],
      "verifactu-ts/client": ["./src/client/index.ts"],
      "verifactu-ts/transport/node": ["./src/client/transports/node.ts"],
      "verifactu-ts/qr/render": ["./src/qr/render/index.ts"],
      "verifactu-ts/testing": ["./src/testing/index.ts"],
      "verifactu-ts/errors": ["./src/errors.ts"],
      "verifactu-ts/no-verifactu": ["./src/no-verifactu.ts"]
    }
  },
  "include": ["src", "test", "scripts", "examples", "*.config.ts"],
  "exclude": ["test/fixtures/nayuki"]
}
