{
  "name": "verifactu-ts",
  "version": "0.0.0",
  "description": "Librería TypeScript para VERI*FACTU (AEAT): registros de facturación, huella, QR y envío SOAP. Sin dependencias nativas.",
  "keywords": [
    "verifactu",
    "veri*factu",
    "aeat",
    "sif",
    "facturacion",
    "factura",
    "hacienda",
    "qr",
    "typescript"
  ],
  "license": "MIT",
  "author": "Jesús Lagares",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lagaress/verifactu-ts.git"
  },
  "homepage": "https://github.com/Lagaress/verifactu-ts#readme",
  "bugs": {
    "url": "https://github.com/Lagaress/verifactu-ts/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./transport/node": {
      "types": "./dist/client/transports/node.d.ts",
      "default": "./dist/client/transports/node.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./qr/render": {
      "types": "./dist/qr/render/index.d.ts",
      "default": "./dist/qr/render/index.js"
    },
    "./no-verifactu": {
      "types": "./dist/no-verifactu.d.ts",
      "default": "./dist/no-verifactu.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc -p tsconfig.types.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "gen": "npm run gen:wire && npm run gen:errors",
    "gen:wire": "node --experimental-strip-types --no-warnings scripts/gen-wire-types.ts",
    "gen:errors": "node --experimental-strip-types --no-warnings scripts/gen-error-catalog.ts",
    "spec:check": "node --experimental-strip-types --no-warnings scripts/fetch-spec.ts --check",
    "check:package": "npm run build && publint && attw --pack . --profile esm-only && npm run size",
    "ci": "npm run typecheck && npm run lint && npm run format:check && npm run gen:check && npm test && npm run check:package",
    "gen:check": "node --experimental-strip-types --no-warnings scripts/gen-wire-types.ts --check && node --experimental-strip-types --no-warnings scripts/gen-error-catalog.ts --check",
    "size": "node --experimental-strip-types --no-warnings scripts/size.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "4.1.11",
    "@xmldom/xmldom": "0.9.12",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "fast-check": "4.10.2",
    "jsqr": "1.4.0",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.7",
    "vitest": "4.1.11",
    "xmllint-wasm": "5.3.0"
  }
}
